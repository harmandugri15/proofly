// Prisma Schema for Proofly (PostgreSQL Production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String            @id @default(uuid())
  email                  String            @unique
  passwordHash           String?
  role                   String            @default("STUDENT")
  name                   String
  avatarUrl              String?
  googleId               String?           @unique
  isEmailVerified        Boolean           @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetOtp       String?
  passwordResetExpires   DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  
  studentProfile         StudentProfile?
  recruiterProfile       RecruiterProfile?
  sessions               Session[]
  auditEvents            AuditEvent[]

  @@index([email])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  websiteUrl  String?
  logoUrl     String?
  verifiedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  recruiters  RecruiterProfile[]
  jobPostings JobPosting[]
  shortlists  Shortlist[]
  notes       RecruiterNote[]

  @@index([slug])
}

model RecruiterProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  organizationId String
  fullName       String
  title          String
  department     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notes          RecruiterNote[]

  @@index([organizationId])
}

model StudentProfile {
  id                   String                  @id @default(uuid())
  userId               String                  @unique
  username             String                  @unique
  headline             String                  @default("")
  bio                  String                  @default("")
  avatarUrl            String?
  location             String?
  visibility           String                  @default("PUBLIC")
  isOpenToWork         Boolean                 @default(true)
  preferredRoles       String                  @default("[]")
  targetGraduationYear Int?
  completenessScore    Int                     @default(0)
  githubUsername       String?
  githubStats          String?
  shareToken           String?                 @unique
  linkedinUrl          String?
  linkedinVerified     Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations           Education[]
  experiences          Experience[]
  skills               Skill[]
  projects             Project[]
  certificates         Certificate[]
  codingProfiles       ExternalCodingProfile[]
  gitHubRepos          GitHubRepo[]
  posts                Post[]
  shortlistEntries     ShortlistCandidate[]
  recruiterNotes       RecruiterNote[]

  @@index([username])
  @@index([visibility])
}

model Education {
  id               String         @id @default(uuid())
  studentProfileId String
  institution      String
  degree           String
  fieldOfStudy     String
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean        @default(false)
  grade            String?
  activities       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model Experience {
  id               String         @id @default(uuid())
  studentProfileId String
  company          String
  title            String
  location         String?
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean        @default(false)
  description      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model Skill {
  id                 String         @id @default(uuid())
  studentProfileId   String
  name               String
  category           String
  proficiencyLevel   String
  yearsOfExperience  Float?
  isVerified         Boolean        @default(false)
  verifiedByCount    Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@index([name])
}

model Project {
  id                 String         @id @default(uuid())
  studentProfileId   String
  title              String
  tagline            String
  description        String
  demoUrl            String?
  repositoryUrl      String?
  skills             String         @default("[]")
  isFeatured         Boolean        @default(false)
  verificationStatus String         @default("UNVERIFIED")
  verificationNotes  String?
  evidenceMetadata   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model Certificate {
  id                 String         @id @default(uuid())
  studentProfileId   String
  title              String
  issuer             String
  credentialId       String?
  credentialUrl      String?
  issueDate          DateTime
  expiryDate         DateTime?
  doesNotExpire      Boolean        @default(false)
  verificationStatus String         @default("UNVERIFIED")
  verificationType   String         @default("URL_CHECK")
  lastVerifiedAt     DateTime?
  verificationLog    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@index([verificationStatus])
}

model ExternalCodingProfile {
  id               String         @id @default(uuid())
  studentProfileId String
  platform         String
  username         String
  profileUrl       String
  totalSolved      Int            @default(0)
  easySolved       Int            @default(0)
  mediumSolved     Int            @default(0)
  hardSolved       Int            @default(0)
  ranking          Int?
  rating           Float?
  badges           String         @default("[]")
  detailedStats    String?
  lastSyncedAt     DateTime?
  syncStatus       String         @default("SYNCED")
  syncError        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, platform])
  @@index([studentProfileId])
}

model GitHubRepo {
  id                   String         @id @default(uuid())
  studentProfileId     String
  githubRepoId         String
  name                 String
  fullName             String
  description          String?
  htmlUrl              String
  primaryLanguage      String?
  languages            String?
  starsCount           Int            @default(0)
  forksCount           Int            @default(0)
  isFork               Boolean        @default(false)
  isSelectedForProfile Boolean        @default(true)
  lastCommitAt         DateTime?
  recentCommitCount    Int            @default(0)
  lastSyncedAt         DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  studentProfile       StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, githubRepoId])
  @@index([studentProfileId])
}

model Post {
  id               String         @id @default(uuid())
  studentProfileId String
  title            String
  slug             String         @unique
  summary          String
  content          String
  tags             String         @default("[]")
  status           String         @default("DRAFT")
  publishedAt      DateTime?
  readTimeMinutes  Int            @default(3)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([studentProfileId])
  @@index([status])
}

model JobPosting {
  id                String         @id @default(uuid())
  organizationId    String
  title             String
  description       String
  location          String
  employmentType    String         @default("Full-time")
  status            String         @default("ACTIVE")
  requiredSkills    String         @default("[]")
  preferredSkills   String         @default("[]")
  minGraduationYear Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model Shortlist {
  id             String               @id @default(uuid())
  organizationId String
  title          String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidates     ShortlistCandidate[]

  @@index([organizationId])
}

model ShortlistCandidate {
  id               String         @id @default(uuid())
  shortlistId      String
  studentProfileId String
  status           String         @default("REVIEWING")
  addedAt          DateTime       @default(now())

  shortlist        Shortlist      @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([shortlistId, studentProfileId])
  @@index([shortlistId])
  @@index([studentProfileId])
}

model RecruiterNote {
  id               String           @id @default(uuid())
  organizationId   String
  recruiterId      String
  studentProfileId String
  content          String
  tags             String           @default("[]")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recruiter        RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentProfileId])
}

model AuditEvent {
  id             String   @id @default(uuid())
  actorId        String?
  organizationId String?
  action         String
  resourceType   String
  resourceId     String
  payload        String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resourceType, resourceId])
}
