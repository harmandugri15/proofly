# ==============================================================================
# Proofly Environment Variables Configuration
# Copy this file to .env and adjust variables as necessary.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend Server Configuration
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL or SQLite)
# For local dev without Docker: file:./dev.db
# For Docker or production Postgres: postgresql://proofly:proofly@localhost:5432/proofly
DATABASE_URL="file:./dev.db"

# Session & Authentication Security
# Generate a secure 64-char random hex string in production: openssl rand -hex 32
JWT_SECRET="proofly-super-secure-jwt-secret-dev-only-32bytes-min"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="proofly-cookie-secret-dev-only"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:4000"

# AI Model Provider Configuration (Optional - falls back to deterministic rule engine if missing)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="auto" # 'gemini' | 'openai' | 'deterministic' | 'auto'

# GitHub Integration (Optional - OAuth app credentials)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/v1/integrations/github/callback"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000 # 1000 requests per window
